# Operations
type Query{
    users: [User!]!
}
type Query{
    user: User!
}


# Objects / types
scalar Date

type User{
    id: ID!
    username: String!
    watchHistory: WatchHistory
    role: Role
}

type Role{
    id: Int
    name: String!
}

type WatchHistory{
    id: ID!
    userId: ID!
    videoId: Int!
    date: Date!
}