# Operations
type Query{
    users: [User!]!
    user(userId: ID!): User
}


# Objects / types
scalar Date

type User{
    userId: ID!
    username: String!
    role: Role
}

type Role{
    roleId: Int
    name: String!
}

type WatchHistory{
    id: ID!
    userId: ID!
    videoId: Int!
    date: Date!
}