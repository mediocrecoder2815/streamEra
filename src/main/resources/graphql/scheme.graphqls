# Operations
type Query{
    # Users
    users: [User!]!
    user(userId: ID!): User,

    # Playback
    videos: [VideoAll!]!,
    video_byName(name: String): Video,
    video_byId(videoId: Long!): Video!,

    # Watch history
    watchHistory: [WatchHistory], # look up user's watch_history by username via token
    watchHistoryByVideo(videoId: Long!): WatchHistory,

}
# Mutation
type Mutation{
    # auth domain
    register(requestDto: AuthInput!): AuthResponse!
    login(requestDto: AuthInput!): AuthResponse!

    # user domain
    updateUser(user: UserUpdate!): User
    deleteUser(userId: ID!): String

    # video domain
    add_video(video: VideoInput): Video
    update_video(video: VideoUpdateInput): Video
    delete_video(videoId: Long): String

    # playback domain
    update_watch_history(watch_history: WatchHistoryInput): WatchHistory
    update_watch_historyProgress(updateInput: WatchHistoryProgressInput): WatchHistory
}

# Input types
input AuthInput{
    username: String!,
    password: String!
}
input WatchHistoryProgressInput{
    watchHistoryId: ID!,
    timestamp: Long!
}
input UserUpdate{
    username: String,
    password: String
}
input VideoInput{
    name: String!,
    format: String!,
    size: Long
}
input VideoUpdateInput{
    videoId: ID!,
    name: String,
    videoUrl: String,
    categoryList: [CategoryInput],
    videoStatus: String
}
input CategoryInput{
    categoryId: Int!,
    name: String!
}
input WatchHistoryInput{
    videoId: ID!,
    date: Date,
    timestamp: String
}
# Objects / types
scalar Date

scalar Long

type Video{
    videoId: Long!,
    name: String!,
    videoLength: Long,
    size: Long,
    videoUrl: String!,
    categorySet: [Category],
    videoStatus: String
}
type VideoAll{
    name: String,
    videoLength: Long,
    categorySet: [Category]
}
type Category{
    categoryId: Int!,
    name: String!
}

type AuthResponse{
    username: String!,
    token: String!
}

type User{
    userId: ID!
    username: String!
    role: Role
}

type Role{
    roleId: Int
    name: String!
}

type WatchHistory{
    watchHistoryId: ID!
    userId: ID!
    videoId: Int!
    date: Date!
}