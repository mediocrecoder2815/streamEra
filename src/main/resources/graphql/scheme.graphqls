# Operations
type Query{
    users: [User!]!
    user(userId: ID!): User
}

# Input types
input AuthInput{
    username: String!,
    password: String!
}
# Mutation
type Mutation{
    register(requestDto: AuthInput!): AuthResponse!
    login(requestDto: AuthInput!): AuthResponse!
}
# Objects / types
scalar Date



type AuthResponse{
    username: String!,
    token: String!
}

type User{
    userId: ID!
    username: String!
    role: Role
}

type Role{
    roleId: Int
    name: String!
}

type WatchHistory{
    id: ID!
    userId: ID!
    videoId: Int!
    date: Date!
}